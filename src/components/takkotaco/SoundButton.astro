---
/**
 * SoundButton (live) - the voice tier of the games' sound layer. On the real
 * site a sound resolves in tiers: a recorded Kenney clip first, then a voice
 * generated with ElevenLabs, and if neither exists the games synthesize the
 * tone themselves with the Web Audio API.
 *
 * Apple plays the clip takkotaco.com actually serves, copied from its
 * audio/vocab folder. Chicken uses the same randomized local voice, pitch and
 * rate selection as TakkoTaco's Mii mode. It falls back to the real chicken
 * clip where speech synthesis is unavailable. The bars are decorative
 * feedback, not a real analyser.
 */
const WORDS = [
  { label: 'Apple', src: '/projects/takkotaco/audio/apple.mp3', say: '' },
  { label: 'Chicken', src: '/projects/takkotaco/audio/chicken.mp3', say: 'chicken' },
];
---

<figure class="sfx-demo">
  <div class="sfx-demo__stage">
    <div class="sfx-demo__bars" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="sfx-demo__btns">
      {
        WORDS.map((w) => (
          <button type="button" class="sfx-btn" data-src={w.src} data-say={w.say}>
            {w.label}
          </button>
        ))
      }
    </div>
  </div>
  <figcaption>
    Live: apple uses the recorded clip. Chicken picks a new Mii-style browser
    voice each time.
  </figcaption>
</figure>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const speech = 'speechSynthesis' in window ? window.speechSynthesis : null;
  let voices: SpeechSynthesisVoice[] = [];

  const preferredVoices = [
    /samantha/i, /karen/i, /moira/i, /tessa/i, /victoria/i,
    /fiona/i, /serena/i, /allison/i, /ava/i, /susan/i, /daniel/i,
  ];
  const loadVoices = () => {
    if (speech) voices = speech.getVoices();
  };
  function pick<T>(items: T[]): T | undefined {
    return items[Math.floor(Math.random() * items.length)];
  }
  const randomBetween = (min: number, max: number) =>
    min + Math.random() * (max - min);
  const miiVoicePool = () => {
    const english = voices.filter((voice) => voice.lang.toLowerCase().startsWith('en'));
    const base = english.length ? english : voices;
    const local = base.filter((voice) => voice.localService);
    const available = local.length ? local : base;
    const preferred = available.filter((voice) =>
      preferredVoices.some((pattern) => pattern.test(voice.name)),
    );
    return preferred.length ? preferred : available;
  };

  loadVoices();
  speech?.addEventListener('voiceschanged', loadVoices);

  document.querySelectorAll<HTMLElement>('.sfx-demo').forEach((demo) => {
    let current: HTMLAudioElement | null = null;
    let active: SpeechSynthesisUtterance | null = null;
    const start = () => {
      if (!reduce) demo.classList.add('is-playing');
    };
    const stop = () => demo.classList.remove('is-playing');

    demo.querySelectorAll<HTMLButtonElement>('.sfx-btn').forEach((btn) => {
      const src = btn.dataset.src;
      if (!src) return;
      const say = btn.dataset.say;

      // Nothing is fetched until the first press.
      const audio = new Audio(src);
      audio.preload = 'none';
      audio.addEventListener('ended', stop);
      audio.addEventListener('error', stop);

      const playClip = () => {
        current = audio;
        audio.currentTime = 0;
        void audio.play().catch(stop);
        start();
      };

      btn.addEventListener('click', () => {
        // Pressing the other word cuts whatever is already going.
        if (current && current !== audio) {
          current.pause();
          current.currentTime = 0;
        }
        // Cancelling fires the old utterance's `end` late, so retire it first.
        active = null;
        speech?.cancel();

        if (!say || !speech) {
          playClip();
          return;
        }

        if (!voices.length) loadVoices();
        const line = new SpeechSynthesisUtterance(say);
        line.lang = 'en-US';
        // Keep the character without hitting the browser's squeaky pitch limit.
        line.pitch = randomBetween(1.25, 1.7);
        line.rate = randomBetween(1.1, 1.35);
        const voice = pick(miiVoicePool());
        if (voice) line.voice = voice;
        line.addEventListener('start', () => {
          if (active === line) start();
        });
        line.addEventListener('end', () => {
          if (active === line) stop();
        });
        // Some browsers list a voice but never speak; fall back to the clip.
        line.addEventListener('error', () => {
          if (active === line) playClip();
        });
        active = line;
        speech.speak(line);
      });
    });
  });
</script>

<style>
  .sfx-demo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sfx-demo__stage {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .sfx-demo__bars {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 34px;
  }
  .sfx-demo__bars span {
    width: 5px;
    height: 30%;
    background: var(--color-accent);
    border-radius: var(--radius-xs);
  }
  .sfx-demo.is-playing .sfx-demo__bars span {
    animation: sfx-bar 0.5s ease-in-out infinite;
  }
  .sfx-demo__bars span:nth-child(2) { animation-delay: 0.08s; }
  .sfx-demo__bars span:nth-child(3) { animation-delay: 0.16s; }
  .sfx-demo__bars span:nth-child(4) { animation-delay: 0.24s; }
  .sfx-demo__bars span:nth-child(5) { animation-delay: 0.32s; }
  @keyframes sfx-bar {
    0%, 100% { height: 25%; }
    50% { height: 95%; }
  }

  .sfx-demo__btns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .sfx-btn {
    appearance: none;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    font-size: var(--text-sm);
    padding: 0.45rem 0.9rem;
    color: var(--color-text);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    transition:
      background var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast);
  }
  .sfx-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .sfx-demo.is-playing .sfx-demo__bars span { animation: none; }
  }
</style>
