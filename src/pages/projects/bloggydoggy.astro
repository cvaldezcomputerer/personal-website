---
/**
 * Bloggy Doggy case study - bespoke individual page (see takkotaco.astro for the
 * pattern). Card metadata comes from the projects content collection; the prose,
 * feature showcase, and the "playful details" style section live here.
 *
 * Features are grouped into two labelled pillars (what the reader gets, what
 * keeps it running), the same primitive takkotaco.astro uses. Two features are
 * live demos rather than screenshots: LangDemo (the trilingual reading modes on
 * a real post paragraph) and QuizDemo (the quiz web component on sample data),
 * and the quiz follows the language toggle via the bd-demo:lang event, same as
 * on the blog. The Explain tooltip is used inline in the overview prose (the
 * Playful details section points it out). The check:post block is that script's
 * real output, trimmed, not a mockup.
 *
 * The style section embeds real artifacts from the blog: the live Loader
 * (SVG + JS, ported), the PressToLight pushbutton toy, and two animated WebPs
 * (the spinning mug and the Olympus camera sticker) served from /public so
 * sharp does not strip their animation.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import LogoTile from '~/components/LogoTile.astro';
import Loader from '~/components/bloggydoggy/Loader.astro';
import LangDemo from '~/components/bloggydoggy/LangDemo.astro';
import QuizDemo from '~/components/bloggydoggy/QuizDemo.astro';
import Explain from '~/components/bloggydoggy/Explain.astro';
import PressToLight from '~/components/bloggydoggy/PressToLight.astro';
import galleryShot from '~/assets/images/bloggydoggy/gallery.png';
import editorShot from '~/assets/images/bloggydoggy/dev-editor.png';
const bloggydoggyLogo = '/logos/bloggydoggy.svg';

const entry = await getEntry('projects', 'bloggydoggy');
if (!entry) throw new Error('Missing projects/bloggydoggy content entry');
const d = entry.data;
const meta = [d.role, d.timeframe].filter(Boolean).join('  ·  ');

const glance: { label: string; value: string; href?: string }[] = [
  {
    label: 'Problem',
    value:
      'I wanted a place to post my photography and write about my life in Japan, with room to experiment on interactive features, and without a frontend framework or off-the-shelf plugins deciding how any of it behaves.',
  },
  { label: 'My role', value: 'Solo designer and developer, 2024 to present.' },
  {
    label: 'Impact',
    value:
      'Trilingual posts the reader controls, plus quizzes and likes on my own Workers and D1 API, all running at no cost on Cloudflare’s free tier.',
  },
];

// The two pillars the feature showcase is grouped under, in render order.
const pillars = [
  { id: 'reader', label: 'What the reader gets' },
  { id: 'authoring', label: 'What keeps it running' },
] as const;
type Pillar = (typeof pillars)[number]['id'];

// Real, trimmed output of `npm run check:post -- --all` in the blog repo.
const checkPostOutput = `$ npm run check:post -- --all

badminton-tournament  clean

camera-c840  1 note
  i 6 unreferenced images kept on purpose (.keep-unused)
      bottom-pic-cam.webp
      cameras-in-store.webp
      old-house.webp
      takko-field.webp
      takko-garlic-lamp.webp
      takko-landscape.webp

rice-planting  clean

school-lunch  clean

14 posts checked — no errors, 0 warnings.`;

const majorFeatures: {
  pillar: Pillar;
  title: string;
  body: string | string[];
  media: 'lang' | 'editor' | 'checkpost';
  image?: ImageMetadata;
  alt?: string;
}[] = [
  {
    pillar: 'reader',
    title: 'Reader-controlled language modes',
    body: 'Every post is readable in normal English, Simple English, and Japanese, switched from a toggle in the navbar. Readers can switch modes without leaving the page, and their selection persists between posts. The blog is read by native English speakers, English learners, and Japanese friends. The demo below uses the production language-switching component on a paragraph from a published post; try the toggle.',
    media: 'lang',
  },
  {
    pillar: 'authoring',
    title: 'A custom editor for trilingual posts',
    body: [
      'A post is not one block of text. It is three language versions of every paragraph, plus captions, plus an image order, and editing that as raw MDX means counting slots by eye and getting it wrong. So the blog has its own editor, dev-only, that parses the MDX file and gives each language, caption, and image slot its own field.',
      'It writes back to the same .mdx file on disk. I can close the editor and keep working in the file by hand, so publishing never depends on the tool staying alive.',
    ],
    media: 'editor',
    image: editorShot,
    alt: 'The dev editor open on a post: each block labelled by type and id, with separate EN, JA and SIMPLE text fields side by side for a paragraph and a heading',
  },
  {
    pillar: 'authoring',
    title: 'A validator that gets stricter when you publish',
    body: [
      'Before publishing, I run a validation script that checks for empty translation slots, missing frontmatter, oversized or unused images, GPS metadata off my phone, mojibake, and leftover placeholder text.',
      'Draft posts report incomplete content as warnings. Once the draft flag is removed, the same findings become errors and the command exits non-zero. This lets me work on incomplete posts without constant failures while still preventing them from being published accidentally.',
    ],
    media: 'checkpost',
  },
];

const minorFeatures: {
  pillar: Pillar;
  title: string;
  body: string;
  media: 'quiz' | 'shot' | 'none';
  image?: ImageMetadata;
  alt?: string;
}[] = [
  {
    pillar: 'reader',
    title: 'Quiz component',
    body: 'Small quizzes at the end of a post, running on my own Cloudflare Workers and D1 API. The demo below uses the production quiz component with sample data, and it follows the language toggle above, the same way every quiz on the blog follows the navbar.',
    media: 'quiz',
  },
  {
    pillar: 'reader',
    title: 'Custom gallery components',
    body: 'Some posts end in a photo gallery. I wanted it to look and behave a specific way and no generic option did it, so I built the component myself.',
    media: 'shot',
    image: galleryShot,
    alt: 'A post gallery on bloggydoggy.com: photos styled as polaroids with handwritten captions, pinned to a grid-paper scrapbook background',
  },
  {
    pillar: 'reader',
    title: 'Reading settings that stay put',
    body: 'Text size, a dark theme, and an option to stop highlighting defined words. All three are stored in localStorage and applied as classes on the root element before first paint, so nothing flashes on load. The highlight switch is there because the underlining that helps a learner is clutter to everyone else.',
    media: 'none',
  },
  {
    pillar: 'reader',
    title: 'The floating island',
    body: 'The language selector and settings live in a small floating bar that can be hidden entirely from the settings panel. On a phone it sits a thumb away from where you are already holding the screen, and it disappears completely for anyone who just wants to read.',
    media: 'none',
  },
  {
    pillar: 'reader',
    title: 'Likes',
    body: 'A like button on the same API. One counter, one endpoint, and no third-party script loading on every post to support it.',
    media: 'none',
  },
  {
    pillar: 'authoring',
    title: 'An image pipeline that takes what my phone gives it',
    body: 'One script eats whatever I drop in a post folder: it converts iPhone HEIC to JPEG, caps anything over 1600px, and strips the metadata I do not want published. I run it the moment photos land, because I need the filenames before I can write the post around them. Astro handles avif and webp at build time, so the script stops where the build takes over.',
    media: 'none',
  },
];
---

<BaseLayout title={d.name} description={d.tagline} type="article">
  <article class="container--prose case">
    <a class="back" href="/#projects">Back to projects</a>

    <header class="case-head">
      <LogoTile src={bloggydoggyLogo} alt={`${d.name} logo`} size="lg" bare href={d.url} class="case-logo" />
      {meta && <p class="eyebrow">{meta}</p>}
      <h1>{d.name}</h1>
      <p class="tagline">{d.tagline}</p>

      <div class="actions">
        {
          d.url && (
            <a class="visit-link" href={d.url} target="_blank" rel="noopener">
              <Icon name="external-link" /> Visit site
            </a>
          )
        }
        {
          d.repo && (
            <a class="btn btn--secondary" href={d.repo} target="_blank" rel="noopener">
              <Icon name="github" /> Code
            </a>
          )
        }
      </div>
    </header>

    <dl class="glance">
      {
        glance.map((g) => (
          <div class="glance-row">
            <dt>{g.label}</dt>
            <dd>
              {g.href ? (
                <a href={g.href} target="_blank" rel="noopener">
                  {g.value}
                </a>
              ) : (
                g.value
              )}
            </dd>
          </div>
        ))
      }
      <div class="glance-row">
        <dt>Stack</dt>
        <dd class="glance-stack">
          {d.stack.map((s) => <span class="chip">{s}</span>)}
        </dd>
      </div>
    </dl>

    <div class="prose">
      <h2>Overview</h2>
      <p>
        I started Bloggy Doggy to publish my photography and write about my life
        in Japan. It also became a{' '}
        <Explain meaning="a place to try new ideas">testing ground</Explain> for
        reading modes and small interactive features. Posts can be read in
        English, Simple English, or Japanese, and the blog has its own quizzes,
        galleries, reading settings, and animations.
      </p>

      <h2>Architecture</h2>
      <p>
        I built the interactive features with native Web Components instead of a
        frontend framework. There is no framework anywhere in this blog.
      </p>
      <p>
        <strong>Astro, deployed as a Cloudflare Worker.</strong> Posts ship as
        static HTML, so pages stay fast and cheap to serve.
      </p>
      <p>
        <strong>A REST API built with Cloudflare Workers and D1.</strong> Likes
        and quiz data go through my own endpoints, so the quiz can follow the
        language toggle and the likes can look like nothing else. I maintain the
        API and its data model myself.
      </p>
      <p>
        <strong>Web Components for every interactive piece.</strong> Each one is
        a custom element, so a post with no interactive parts ships no JavaScript
        at all.
      </p>
      <p>
        <strong>A single-source reading-mode system.</strong> The three language
        modes come from one source file, not separate pages or routes, so there
        is no second copy of a post drifting out of sync. The cost is authoring
        time. A post is not done until it works in all three.
      </p>
    </div>

    <section class="features" aria-label="Favorite parts">
      <h2>Favorite parts</h2>

      {
        pillars.map((pillar) => (
          <div class="pillar">
            <h3 class="pillar-head">{pillar.label}</h3>

            <div class="major-list">
              {majorFeatures
                .filter((f) => f.pillar === pillar.id)
                .map((f) => (
                  <article class="major">
                    <div class="major-text">
                      <h4>{f.title}</h4>
                      {(Array.isArray(f.body) ? f.body : [f.body]).map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                    {f.media === 'lang' && <LangDemo />}
                    {f.media === 'checkpost' && (
                      <pre class="terminal"><code>{checkPostOutput}</code></pre>
                    )}
                    {f.media === 'editor' && f.image && (
                      <Image class="major-shot" src={f.image} alt={f.alt ?? ''} width={1440} />
                    )}
                  </article>
                ))}
            </div>

            <div class="minor-list">
              {minorFeatures
                .filter((f) => f.pillar === pillar.id)
                .map((f) => (
                  <article
                    class:list={[
                      'minor',
                      { 'minor--stack': f.media === 'quiz' },
                      { 'minor--text': f.media === 'none' },
                    ]}
                  >
                    <div class="minor-text">
                      <h5>{f.title}</h5>
                      <p>{f.body}</p>
                    </div>
                    {f.media === 'quiz' && <QuizDemo />}
                    {f.media === 'shot' && f.image && (
                      <Image class="minor-shot" src={f.image} alt={f.alt ?? ''} width={520} />
                    )}
                  </article>
                ))}
            </div>
          </div>
        ))
      }
    </section>

    <!-- Playful details / style -->
    <section class="style" aria-label="Playful details">
      <h2>Playful details</h2>
      <p class="style-intro">
        The small animated touches are half the reason I like building my own
        blog. A few favorites, live below:
      </p>
      <div class="style-grid">
        <figure class="style-tile">
          <div class="style-stage style-stage--loader">
            <Loader size={64} stepMs={620} />
          </div>
          <figcaption>
            <strong>Loading animation.</strong> Garlic shapes morph to dots and
            back around the logo, drawn as SVG. I built it after getting curious
            about the scene transitions in a show I like.
          </figcaption>
        </figure>

        <figure class="style-tile">
          <div class="style-stage">
            <img
              src="/projects/bloggydoggy/red-cup-spin.webp"
              alt="A red cup spinning"
              loading="lazy"
              decoding="async"
              width="180"
              height="180"
            />
          </div>
          <figcaption>
            <strong>Spinning cup.</strong> An animated WebP from the post about
            finishing my cup set. Not SVG, just a bit of fun.
          </figcaption>
        </figure>

        <figure class="style-tile">
          <div class="style-stage">
            <img
              src="/projects/bloggydoggy/olympus-camera-sticker.webp"
              alt="Animated Olympus Camedia C-840L camera sticker"
              loading="lazy"
              decoding="async"
              width="128"
              height="128"
            />
          </div>
          <figcaption>
            <strong>Camera sticker.</strong> A little animated marker for the
            vintage Olympus I shot a whole post on.
          </figcaption>
        </figure>

        <figure class="style-tile">
          <div class="style-stage style-stage--ptl">
            <PressToLight />
          </div>
          <figcaption>
            <strong>Press to light.</strong> From the culture-festival post:
            press the tactile switch and the LED in the photo lights up. Go
            ahead, press it.
          </figcaption>
        </figure>
      </div>

      <p class="style-note">
        One more is hiding in plain sight: the dotted-underlined phrase up in
        the overview is the blog's Explain tooltip, a component for quietly
        defining words a learner might not know, using the same behavior as on
        the blog.
      </p>
    </section>

    <div class="prose">
      <h2>What I took away</h2>
      <p>
        Native Web Components have worked well for isolated features like the
        quizzes, tooltips, galleries and settings panel. Posts without those
        components do not have to ship their JavaScript, and I have not needed a
        framework to hold any of it together.
      </p>
      <p>
        Image handling needed more automation than I expected. The preprocessing
        script now converts HEIC files, resizes large photos, and strips metadata
        before Astro builds the final avif and webp versions. Before that I was
        double-optimizing some images and skipping others entirely, then
        wondering why some posts felt slow.
      </p>
      <p>
        Some interactive features were more distracting than useful. I removed a
        few and made others optional through the settings panel, so the blog
        still works as a straightforward reading experience.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .case { padding-block: var(--space-7) var(--space-9); }

  .back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }
  .back:hover { color: var(--color-accent); }
  .back::before { content: '\2190'; margin-right: 0.4em; }

  .case-head { margin-bottom: var(--space-6); }
  :global(.case-logo) { margin-bottom: var(--space-5); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }
  .case-head h1 { font-size: var(--text-3xl); margin-bottom: var(--space-3); }
  .tagline { color: var(--color-text-muted); font-size: var(--text-lg); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-5); }
  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: color var(--transition-base), border-color var(--transition-base);
  }
  .visit-link svg { width: 0.9em; height: 0.9em; flex: none; }
  .visit-link:hover { color: var(--color-accent); border-color: var(--color-accent); }

  .glance {
    margin: var(--space-6) 0 var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }
  .glance-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .glance-row:first-child { border-top: 0; }
  .glance dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding-top: 0.15em;
  }
  .glance dd { margin: 0; color: var(--color-text); }
  .glance dd a { color: var(--color-accent); }
  .glance-stack { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  /* Feature screenshots. <Image> output carries no parent scope, so :global. */
  .minor :global(.minor-shot) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .features { margin: var(--space-8) 0; }
  .features > h2 { font-size: var(--text-2xl); margin-bottom: var(--space-6); }

  /* Pillar: the one grouping primitive both case studies share. */
  .pillar + .pillar { margin-top: var(--space-9); }
  .pillar-head {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .major-list { display: flex; flex-direction: column; gap: var(--space-8); }
  .major-text h4 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .major-text p { color: var(--color-text-muted); max-width: 64ch; margin-bottom: var(--space-4); }

  /* Real check:post output. Scrolls on its own so the page never does. */
  .terminal {
    margin: 0;
    padding: var(--space-5);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--color-text-muted);
    tab-size: 2;
  }
  .terminal code { font: inherit; color: inherit; background: none; }

  .minor-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-7);
  }
  .minor {
    display: grid;
    grid-template-columns: 1fr 12rem;
    gap: var(--space-5);
    align-items: center;
  }
  /* Alternate which side the media sits on, keeping the column proportions:
     without swapping the track sizes too, the text lands in the narrow track. */
  .minor:nth-child(even):not(.minor--stack):not(.minor--text) {
    grid-template-columns: 12rem 1fr;
  }
  .minor:nth-child(even):not(.minor--stack):not(.minor--text) .minor-text { order: 2; }
  .minor-text h5 { font-size: var(--text-base); margin-bottom: var(--space-2); }
  .minor-text p { color: var(--color-text-muted); max-width: 52ch; }
  .minor--text { grid-template-columns: 1fr; }

  /* A minor whose media is a live demo too wide for the side column. */
  .minor--stack { grid-template-columns: 1fr; gap: var(--space-4); }
  .minor--stack .minor-text { order: 0; }

  /* Playful details */
  .style { margin: var(--space-9) 0 var(--space-8); }
  .style > h2 { font-size: var(--text-2xl); margin-bottom: var(--space-2); }
  .style-intro { color: var(--color-text-muted); max-width: 60ch; margin-bottom: var(--space-6); }
  /* Four tiles now, so 2x2 instead of a 3-wide row. */
  .style-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .style-tile { margin: 0; }
  .style-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
  }
  /* The pushbutton tile holds a photo + the switch, so it sets its own height. */
  .style-stage--ptl { aspect-ratio: auto; }
  .style-stage img { max-width: 100%; height: auto; display: block; }
  .style-tile figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-top: var(--space-3);
  }
  .style-tile figcaption strong { color: var(--color-text); }

  .style-note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-top: var(--space-5);
  }

  @media (max-width: 720px) {
    .style-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .glance-row { grid-template-columns: 1fr; gap: var(--space-1); }
    .minor { grid-template-columns: 1fr; }
    .minor:nth-child(even) .minor-text { order: 0; }
    .minor:nth-child(even):not(.minor--stack):not(.minor--text) { grid-template-columns: 1fr; }
  }
</style>
