---
/**
 * Takko Town case study - a bespoke individual page (not the shared [slug]
 * template). Card metadata (name, tagline, stack, url) still comes from the
 * projects content collection so the homepage stays in sync; the prose and the
 * feature showcase live here so this page can carry its own additions (the
 * at-a-glance panel and the live SVG map).
 *
 * Feature layout: features are grouped into two labelled pillars (the classroom
 * platform, the town record). Within a pillar, majors get the editorial
 * treatment (big media, one per row) and minors follow as compact alternating
 * rows. Four minors are live artifacts rather than screenshots: the
 * stroke-letter system (StrokeWord, drawn on scroll), the language toggle,
 * the sound buttons, and the prefecture map (JapanMap, hoverable).
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Icon from '~/components/Icon.astro';
import ProjectCaseHeader from '~/components/ProjectCaseHeader.astro';
import JapanMap from '~/components/JapanMap.astro';
import StrokeWord from '~/components/takkotaco/StrokeWord.astro';
import LangToggle from '~/components/takkotaco/LangToggle.astro';
import SoundButton from '~/components/takkotaco/SoundButton.astro';
import gamesShot from '~/assets/images/takkotaco/games.png';
import worksheetShot from '~/assets/images/takkotaco/worksheet-maker.png';
import guideShot from '~/assets/images/takkotaco/town-guide.png';
import feedbackShot from '~/assets/images/takkotaco/feedback-widget.png';
import faceCatchShot from '~/assets/images/takkotaco/face-catch.png';
import wordSetsShot from '~/assets/images/takkotaco/word-sets.png';
import trainShot from '~/assets/images/takkotaco/train-mode.png';
import restaurantsShot from '~/assets/images/takkotaco/restaurants.png';
const takkotacoLogo = '/logos/takkotaco.svg';

const entry = await getEntry('projects', 'takkotaco');
if (!entry) throw new Error('Missing projects/takkotaco content entry');
const d = entry.data;
const meta = [d.role, d.timeframe].filter(Boolean).join('  ·  ');

// Skimmable summary: the five things a visitor reads before deciding to scroll.
const glance: { label: string; value: string; href?: string }[] = [
  {
    label: 'Problem',
    value:
      'My town had almost nothing in English online, just a page that read like it went through Google Translate once. My classes also needed tools built for slow school Chromebooks and unreliable wifi.',
  },
  { label: 'My role', value: 'Solo designer and developer, 2024 to present.' },
  {
    label: 'Impact',
    value:
      'Around twenty-five classroom games and tools, used weekly in my classes, running at no cost on Cloudflare’s free tier.',
  },
];

// The two pillars the feature showcase is grouped under, in render order.
const pillars = [
  { id: 'classroom', label: 'The classroom platform' },
  { id: 'town', label: 'The town record' },
] as const;
type Pillar = (typeof pillars)[number]['id'];

// Major features: editorial, big media. Image is optional: a text-forward major
// is fine where no single screenshot captures it. Body can be several paragraphs.
const majorFeatures: {
  pillar: Pillar;
  title: string;
  body: string | string[];
  image?: ImageMetadata;
  alt?: string;
}[] = [
  {
    pillar: 'classroom',
    title: 'A growing classroom toolkit',
    body: 'Around twenty-five games and classroom tools now, from flashcard and worksheet makers to word races and drawing games. I built them with the technology students and teachers actually use in class in mind: slow Chromebooks and a projector. I do not have a list of features I plan to implement. I add things when I need them, when I have a cool idea, or when a fellow teacher suggests one. Sometimes I remove them right after.',
    image: gamesShot,
    alt: 'The takkotaco.com games page: a grid of classroom game cards including Directions Game, How Many?, Letter Flip Game, Face Catch, Letter or Not?, and Anarika\'s Star Hunt, each with topic tags, a Play button and a share button',
  },
  {
    pillar: 'classroom',
    title: 'One vocabulary database, and how I add new words quickly',
    body: [
      'Every game and tool that touches vocabulary reads from one typed database. A word is a single entry: the English, the Japanese readings I will accept as correct, and an optional kanji spelling. Two generated manifests map that word to its picture and its voice clip, so a flashcard game, a printable worksheet, the review challenge, and the dictionary all pull from the same source and never drift apart. The database now covers 53 categories across 12 groups.',
      'I tried to make adding a word as smooth as possible because otherwise I kept putting it off! A new word starts as one line of text, and that is enough to be useful. Every game can use it immediately, since anything that reads out loud falls back to a browser voice until a recording exists. I do not let having to record voice lines get in the way of getting a word finished and usable.',
      'I add the picture and recorded voice later. Images run through a small pipeline. I pull candidates from free photo APIs (Pexels and Pixabay), pick the best in a local review gallery, and it is optimized to a webp with its credit saved. When a photo will not do, I use a Japanese illustration or drop in my own drawing. The voice is batch-generated with ElevenLabs in a clear teacher voice, and the script skips clips that already exist, so adding ten words and re-running only fills the ten gaps. Both are just paths in the manifest, so when I later record a word in my own voice or swap a stock photo for an illustration, it updates everywhere at once.',
      'The same database also powers 124 grammar points. A point is a template plus typed slot specs, so "I like ___" knows it wants a gerund and not a bare verb. Word classes finer than noun and verb are what keep the generated sentences usable, and they are what I got wrong on the first pass. With only loose types, random fills will happily tell a student they can eat curry in Switzerland.',
    ],
    image: worksheetShot,
    alt: 'The worksheet maker: word categories and page options on the left, a live preview of a printable vocabulary sheet with illustrated drink words on the right',
  },
  {
    pillar: 'town',
    title: 'Writing the town down in English',
    body: [
      'This did not start with games. It started because the place I live barely existed in English, and the details that make Takko feel like Takko were not written down anywhere I could point to. The town guide is written by someone who lives here, and it covers the town from the perspective of somebody who works in it.',
      'Most of my time on it has gone into the dialect. Takko-ben is the local way of speaking, and it is fading with the older generation. I transcribed a local book,「南部田子の言葉」, cover to cover into a searchable dictionary: 1,810 entries, each with the dialect spelling, a standard-Japanese reading, and an English gloss, plus a word of the day on the front page. It was a slow and tedious process, but it was a way I could give back, in my own way, to the town that has given so much to me.',
      'I have also started adding bilingual pages for the local shrines, with their history and the deity each one honors. I want to keep going: more shrines, the seasonal festivals, and the small attractions a tourism page will never bother with. I have lived and worked here since 2023, and I want the details you only pick up by being here to be readable by someone who does not speak Japanese.',
    ],
    image: guideShot,
    alt: 'The takkotaco.com homepage: a student-painted mural behind "Welcome to Takko Machi", with links to the English games and the town guide',
  },
];

// Minor features: compact alternating rows. Four are live artifacts ported from
// the real site (letters, lang, sound, map); the rest are screenshots.
const minorFeatures: {
  pillar: Pillar;
  title: string;
  body: string;
  media: 'letters' | 'map' | 'lang' | 'sound' | 'shot' | 'none';
  image?: ImageMetadata;
  alt?: string;
  // A screenshot too dense to read in the narrow side column: render it
  // full-width under the text instead.
  wide?: boolean;
}[] = [
  {
    pillar: 'classroom',
    title: 'Games that use the camera and the mic',
    body: 'Two games lean on the Chromebook’s own hardware, in the browser, with nothing to install. Face Catch turns on the webcam and tracks the player’s face, so a student moves their head to catch letters falling across the screen. Letter or Not listens through the microphone instead: a shape flashes up, the class shouts YES or NO, and speech recognition scores it. If a student refuses camera or microphone permission, the game explains what happened and the lesson can keep moving.',
    media: 'shot',
    image: faceCatchShot,
    alt: 'Face Catch running: a webcam view with a heart marker tracking the player’s face, a letter U falling from the left, and score, best and lives readouts above',
  },
  {
    pillar: 'classroom',
    title: 'SVG letter system',
    body: 'Every stylized letter across the games is a set of pen strokes stored in handwriting order, so anything that uses them can also draw them the way a hand would: tracing practice, name writing, the ABC games. The letters here are drawn by that system.',
    media: 'letters',
  },
  {
    pillar: 'classroom',
    title: 'How the games find a voice',
    body: 'Words use a recorded voice clip when one exists, then fall back to the browser voice so a new word works before I make its audio. Mii mode changes it into a voice that is a little silly and more fun than the normal browser voice. Apple here is the generated clip the games serve. Chicken uses that same Mii system, and it should sound a little different on every press.',
    media: 'sound',
  },
  {
    pillar: 'classroom',
    title: 'Word sets a teacher can build',
    body: 'Teachers sign in with Google and build their own word sets, which then feed any tool or game on the site. A set is just a name and a list of words, so a unit’s vocabulary becomes a worksheet, a flashcard round, and a race without retyping it three times. Sign-in is hand-rolled against Google OAuth, with the session held in KV.',
    media: 'shot',
    wide: true,
    image: wordSetsShot,
    alt: 'The My Word Sets page: two saved sets, "4th grade" and "Unit 4", each showing its word chips and bilingual edit and delete buttons',
  },
  {
    pillar: 'classroom',
    title: 'Feedback to Discord',
    body: 'A widget on the games that posts student messages straight into a Discord channel. I added it as an experiment; it is now the fastest feedback loop I have for what works.',
    media: 'shot',
    image: feedbackShot,
    alt: 'The feedback widget panel: a Japanese postbox illustration above a message box and send button',
  },
  {
    pillar: 'town',
    title: 'Japanese built in, not left to Google Translate',
    body: 'Every string on the site is stored as an English and Japanese pair. Most games and tools then show both at once, side by side, and a few parts of the site swap between them on a switch. The Japanese is prepared ahead of time instead of left to Google Translate, which misses the context of the short instructional phrases a game runs on. Having it ready in advance also means it can be kept simple enough for kids to read, and a student who has to leave the page to find out what a rule means has already stopped playing. Try the switch on the card to see the same system working here.',
    media: 'lang',
  },
  {
    pillar: 'town',
    title: 'Places worth going, written up properly',
    body: 'Nineteen restaurants and the local shrines, each with its own bilingual page: what to order, what the room is like, what the shrine is there for. The restaurant list opens on a map of the town with every place pinned and filtered by what kind of food it is.',
    media: 'shot',
    wide: true,
    image: restaurantsShot,
    alt: 'The Takko restaurants page: a hanging wooden shop sign reading Restaurants, an English introduction to eating in town, and a map of Takko with fourteen numbered pins colour-coded by category',
  },
  {
    pillar: 'town',
    title: 'Train ticket mode',
    body: 'A toggle in the navbar turns the site into a train station. The link cards become JR tickets with a route, a fare and a serial number, the section headers become LED departure boards, and the town guide nav becomes a platform direction sign. It is kind of janky and purely for fun, but it makes me happy. I hope it makes any fellow train fans who come across it happy too.',
    media: 'shot',
    wide: true,
    image: trainShot,
    alt: 'takkotaco.com in train mode: an LED departure board scrolling tool names, two link cards styled as JR tickets marked 乗車券 TICKET and 特急券 EXPRESS, and the town guide links styled as a yellow and blue station direction sign',
  },
  {
    pillar: 'town',
    title: '"Where are you from?" map',
    body: 'Visitors tap the prefecture they are from and a pin appears, backed by a Worker and D1. It never stores a raw IP. Each visitor is a salted hash, so a repeat tap moves a pin instead of stacking a new one. I use it as an icebreaker at the start of class. The map here is the same SVG the site uses. Hover it.',
    media: 'map',
  },
];
---

<BaseLayout title={d.name} description={d.tagline} type="article">
  <article class="container case">
    <a class="back" href="/#projects">Back to projects</a>

    <ProjectCaseHeader
      name={d.name}
      tagline={d.tagline}
      meta={meta}
      logo={takkotacoLogo}
      url={d.url}
      repo={d.repo}
    />

    <!-- At a glance -->
    <dl class="glance">
      {
        glance.map((g) => (
          <div class="glance-row">
            <dt>{g.label}</dt>
            <dd>
              {g.href ? (
                <a href={g.href} target="_blank" rel="noopener">
                  {g.value}
                </a>
              ) : (
                g.value
              )}
            </dd>
          </div>
        ))
      }
      <div class="glance-row">
        <dt>Stack</dt>
        <dd class="glance-stack">
          {d.stack.map((s) => <span class="chip">{s}</span>)}
        </dd>
      </div>
    </dl>

    <div class="prose">
      <h2>Overview</h2>
      <p>
        I started the site to solve problems I kept running into while teaching.
        It now does two jobs: an English guide to the town I live in, and a
        classroom platform my students open every week. That covers a bilingual
        town guide, a shelf of games and tools, a dictionary keeping the local
        dialect (Takko-ben) written down, and one vocabulary database sitting
        under all of it.
      </p>

    </div>

    <!-- Features, grouped into two pillars: majors then minors within each -->
    <section class="features" aria-label="Features">
      {
        pillars.map((pillar) => (
          <div class="pillar">
            <h2 class="pillar-head">{pillar.label}</h2>

            <div class="major-list">
              {majorFeatures
                .filter((f) => f.pillar === pillar.id)
                .map((f) => (
                  <article class="major">
                    <div class="major-text">
                      <h3>{f.title}</h3>
                      {(Array.isArray(f.body) ? f.body : [f.body]).map((para) => (
                        <p>{para}</p>
                      ))}
                    </div>
                    {f.image && (
                      <Image class="major-shot" src={f.image} alt={f.alt ?? ''} width={1440} />
                    )}
                  </article>
                ))}
            </div>

            <div class="minor-list">
              {minorFeatures
                .filter((f) => f.pillar === pillar.id)
                .map((f) => (
                  <article
                    class:list={[
                      'minor',
                      { 'minor--live': ['letters', 'map', 'lang', 'sound'].includes(f.media) },
                      { 'minor--map': f.media === 'map' },
                      { 'minor--text': f.media === 'none' || (f.media === 'shot' && !f.image) },
                      { 'minor--stack': f.wide === true },
                    ]}
                  >
                    <div class="minor-text">
                      <h4>{f.title}</h4>
                      <p>{f.body}</p>
                    </div>
                    {f.media === 'letters' && <StrokeWord word="Takko" />}
                    {f.media === 'lang' && <LangToggle />}
                    {f.media === 'sound' && <SoundButton />}
                    {f.media === 'map' && (
                      <div class="minor-map">
                        <JapanMap />
                      </div>
                    )}
                    {f.media === 'shot' && f.image && (
                      <Image
                        class="minor-shot"
                        src={f.image}
                        alt={f.alt ?? ''}
                        width={f.wide ? Math.min(f.image.width, 1200) : 520}
                      />
                    )}
                  </article>
                ))}
            </div>
          </div>
        ))
      }

      <p class="minor-more">
        I have built more than I could fit here, including a train timer tuned
        to exactly how I run class transitions, a typing game with an
        on-screen keyboard guide, and a name-writing tool built on the letter
        system above. New tools get added when a lesson needs one.
      </p>
    </section>

    <div class="prose">
      <h2>What I took away</h2>
      <p>
        Classroom games have to be simple enough to explain in about three
        minutes and light enough to run on an old Chromebook over slow wifi.
        Features that looked good while I was building them did not always hold
        up in front of thirty students.
      </p>
      <p>
        The shared vocabulary database turned out to be the decision that saved
        me the most work. Once a word is in, it can show up in the games, the
        flashcards, the worksheet maker and the dictionary without any extra
        work. Every tool I have built since has benefited from it.
      </p>
      <p>
        Cloudflare's free tier has covered everything so far. Workers, D1, KV and
        Durable Objects have let me add backend features without maintaining a
        server. I came in assuming I would eventually have to pay for one, and I
        still have not.
      </p>
    </div>

    <!-- Architecture last: one row per piece of the stack -->
    <section class="arch" aria-label="Architecture">
      <h2>Architecture</h2>
      <p class="arch-intro">
        I built the site for school Chromebooks on rural wifi, in a way that
        costs me almost nothing to run. It probably still would even if every
        ALT in Japan started using it. It is Astro deployed as a Cloudflare
        Worker, and it has never cost me anything.
      </p>

      <div class="arch-list">
        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="file-code" class="arch-icon" /> Astro, static-first
          </h3>
          <p>
            Most pages ship as plain HTML, so they hold up on bad wifi and old
            hardware. There is no always-on server behind any of it.
          </p>
        </div>

        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="box" class="arch-icon" /> Durable Objects for live class games
          </h3>
          <p>
            Real-time games run on their own Workers, routed under
            takkotaco.com, where each room is one Durable Object holding the
            game state and talking to every device over WebSockets. The first
            real use is a Kahoot-style class quiz: the projector hosts,
            students join from their tablets with a room code, and the room
            keeps the answer to itself until the reveal. Room state lives in
            the object's storage, so a restart mid-question does not lose the
            game. It went in front of a class of about thirty for the first
            time in October 2026, and it stays marked work in progress while I
            fix what that class turned up.
          </p>
        </div>

        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="zap" class="arch-icon" /> Workers for the API
          </h3>
          <p>
            A Worker handles live weather, leaderboards, the "where are you
            from?" map, and the feedback widget that posts straight to Discord.
            Anything that touches a visitor's IP stores only a salted SHA-256
            hash of it, never the raw address. Between lessons it runs nothing
            and bills nothing. Every feature has to fit inside a single request:
            a short execution window, no long-running processes, nothing held in
            memory between calls.
          </p>
        </div>

        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="database" class="arch-icon" /> D1 and KV for storage
          </h3>
          <p>
            D1 (SQLite at the edge) backs the leaderboards and feedback; KV
            holds sessions. Both sit close to the people using them and both
            stay inside the free tier. D1 has limits on heavy write traffic,
            which would matter for a product; at current classroom
            traffic, a class of thirty submitting scores is nowhere near that
            ceiling.
          </p>
        </div>

        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="book-open" class="arch-icon" /> One central vocabulary database
          </h3>
          <p>
            Every game and tool that touches vocab reads from the same source,
            so a word I add during third period is in the flashcards, the
            worksheet maker and the dictionary by fourth. If I change how the
            vocabulary is structured, I also have to update every game and tool
            that uses it.
          </p>
        </div>

        <div class="arch-row">
          <h3 class="arch-head">
            <Icon name="triangle-alert" class="arch-icon" /> Production issues
          </h3>
          <p>
            The site started on Cloudflare Pages and is Workers-only now. Two
            production problems were especially hard to spot. Build-time variables and runtime
            secrets live in different dashboard panels, and putting a build-time
            one in the runtime panel fails silently: the build passes, the
            deploy passes, and the feature renders its fallback in production
            while working fine locally. Then an audit in August 2026 turned up 31
            stray files, 1.4 MB of Vite dev-toolbar bundles, that had been
            shipping to production from inside <code>public/</code>, invisible
            to git but not to the build. Retiring the old Pages project was its
            own small saga: it had 157 deployments, and Pages will not delete a
            project with more than a hundred, so they had to go through the API
            one at a time.
          </p>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .case { padding-block: var(--space-7) var(--space-9); }
  .case > .prose { max-width: 64ch; }

  .back {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-5);
  }
  .back:hover { color: var(--color-accent); }
  .back::before { content: '\2190'; margin-right: 0.4em; }

  /* At a glance */
  .glance {
    margin: var(--space-6) 0 var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    overflow: hidden;
  }
  .glance-row {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-top: 1px solid var(--color-border);
  }
  .glance-row:first-child { border-top: 0; }
  .glance dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    padding-top: 0.15em;
  }
  .glance dd { margin: 0; color: var(--color-text); }
  .glance dd a { color: var(--color-accent); }
  .glance-stack { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.2rem 0.5rem;
  }

  /* Feature screenshots. <Image> output carries no parent scope, so :global. */
  .major :global(.major-shot),
  .minor :global(.minor-shot) {
    width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  /* Features */
  .features { margin: var(--space-8) 0; }

  /* Pillar: the one grouping primitive both case studies share. */
  .pillar + .pillar { margin-top: var(--space-9); }
  .pillar-head {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .major-list { display: flex; flex-direction: column; gap: var(--space-8); }
  .major-text h3 { font-size: var(--text-lg); margin-bottom: var(--space-2); }
  .major-text p { color: var(--color-text-muted); max-width: 64ch; margin-bottom: var(--space-4); }

  .minor-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-7);
  }
  .minor {
    display: grid;
    grid-template-columns: 1fr 12rem;
    gap: var(--space-5);
    align-items: center;
  }
  .minor + .minor {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  /* Alternate which side the media sits on, keeping the column proportions:
     without swapping the track sizes too, the text lands in the narrow track. */
  .minor:nth-child(even):not(.minor--stack):not(.minor--text) {
    grid-template-columns: 12rem 1fr;
  }
  .minor:nth-child(even):not(.minor--stack):not(.minor--text) .minor-text { order: 2; }
  .minor-text h4 { font-size: var(--text-base); margin-bottom: var(--space-2); }
  .minor-text p { color: var(--color-text-muted); max-width: 52ch; }

  /* Live artifacts (letters, map) earn a wider media column than screenshots. */
  .minor--live { grid-template-columns: 1fr 17rem; }
  .minor--live:nth-child(even):not(.minor--stack) { grid-template-columns: 17rem 1fr; }
  .minor--map:nth-child(even):not(.minor--stack) { grid-template-columns: minmax(20rem, 24rem) 1fr; }
  .minor--text { grid-template-columns: 1fr; }

  /* A screenshot too dense for the side column: full width under the text. */
  .minor--stack { grid-template-columns: 1fr; gap: var(--space-4); }
  .minor--stack .minor-text { order: 0; }
  .minor-map { min-width: 0; }

  .minor-more {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    max-width: 64ch;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  /* Architecture: same contained-panel primitive as the glance list up top. */
  .arch { margin: var(--space-9) 0 0; }
  .arch > h2 { font-size: var(--text-2xl); margin-bottom: var(--space-3); }
